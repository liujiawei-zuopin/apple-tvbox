<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categoryScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/categoryContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="0dp"
        android:paddingBottom="80dp">

        <!-- 1. Hero Carousel Section (Edge-to-Edge with Smooth Bottom Alpha Feathering) -->
        <FrameLayout
            android:id="@+id/categoryHeroSection"
            android:layout_width="match_parent"
            android:layout_height="476dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="0dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Alpha Fade Poster Container: Smoothly fades out poster bottom to 0 alpha for seamless ambient blending -->
            <com.fongmi.android.tv.ui.custom.AlphaFadeFrameLayout
                android:id="@+id/categoryHeroFadeContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Hero Poster Backdrop Image (Crisp Backdrop without dark mask) -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/categoryHeroBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </com.fongmi.android.tv.ui.custom.AlphaFadeFrameLayout>

            <!-- Hero Synopsis & Play Button (Centered comfortably in vertical mid-height) -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/categoryHeroInfo"
                android:layout_width="660dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_marginStart="44dp"
                android:layout_marginTop="170dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <!-- Animated Text Group: Fixed height container (124dp) to ensure 0px vertical jump for Play button across 1/2/3 lines of synopsis -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/categoryHeroTextGroup"
                    android:layout_width="match_parent"
                    android:layout_height="124dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/categoryHeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="周处除三害" />

                    <TextView
                        android:id="@+id/categoryHeroMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12.5sp"
                        tools:text="4K 超清 · 8.1分 · 2024 · 动作 / 犯罪" />

                    <TextView
                        android:id="@+id/categoryHeroDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="3"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12.5sp"
                        tools:text="通缉犯陈桂林以为自己患上绝症，生命将尽，决心查出通缉榜上排名在自己前面的两大罪犯，并将其除掉以扬名立万。" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Apple tvOS Action Row: ▶ 立即播放 Button with stable top margin -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/categoryHeroActionRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- ▶ 立即播放 Button (Frosted Translucent Pill -> Crisp Solid White on Focus) -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/categoryBtnPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/selector_hero_play_btn"
                        android:clickable="true"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="20dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/categoryBtnPlayIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_widget_play" />

                        <TextView
                            android:id="@+id/categoryBtnPlayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:text="立即播放"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Carousel Page Indicator Dots (Horizontally centered in lower area of Hero Section) -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/categoryHeroDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- 2. Shelf 1: "推荐" (16:9 Landscape compact cards, half-peeking at first screen bottom) -->
        <TextView
            android:id="@+id/categoryHeaderRecommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="4dp"
            android:text="推荐"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerRecommend"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:paddingStart="40.5dp"
            android:paddingEnd="44dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- 3. Shelf 2: Sub-genre 1 (e.g. 动作 - 2:3 Portrait Cards, 138dp x 214dp aligned with 16:9) -->
        <TextView
            android:id="@+id/categoryHeaderSubGenre1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="动作"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerSubGenre1"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            android:paddingStart="40.5dp"
            android:paddingEnd="44dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 4. Shelf 3: Sub-genre 2 (e.g. 爱情 - 2:3 Portrait Cards, 138dp x 214dp aligned with 16:9) -->
        <TextView
            android:id="@+id/categoryHeaderSubGenre2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="爱情"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerSubGenre2"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            android:paddingStart="40.5dp"
            android:paddingEnd="44dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 5. Section 4: "全部影片" (All Movies / All Content with Filters & 5-Column Grid) -->
        <TextView
            android:id="@+id/categoryHeaderAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="全部影片"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sub-category Filter Chips -->
        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/categoryFilterRecycler"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:focusOutEnd="false"
            app:focusOutFront="false" />

        <!-- 5-Column Poster Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="38dp"
            android:paddingEnd="44dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
