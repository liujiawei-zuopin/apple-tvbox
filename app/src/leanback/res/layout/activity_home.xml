<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101012"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Layer 0: Full-screen Hero Backdrop -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Layer 1: Dark Cinematic Scrim Overlay -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_scrim_hero" />

    <!-- Layer 2: Main Interactive Content Layer -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="44dp"
            android:paddingEnd="44dp">

            <!-- Top Navigation Bar (Centered Frosted Capsule Bar + Real-time Clock) -->
            <RelativeLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_alignParentTop="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="16dp"
                android:paddingBottom="6dp">

                <!-- Center: Apple TV Style Translucent Capsule Tabs Bar -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/topNavContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_top_capsule_bar"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/topNavRecycler"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nextFocusDown="@id/recyclerWatchNow"
                        app:focusOutEnd="false"
                        app:focusOutFront="false" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Right: Real-time Clock -->
                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/white_90"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="17:30" />
            </RelativeLayout>

            <!-- Main Interactive Content Container -->
            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/topBar"
                android:clipChildren="true"
                android:clipToPadding="false">

                <!-- 1. Home Shelves ScrollView (Hero Synopsis + Now Watching + Continue + Hot Picks) -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/homeScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingBottom="60dp">

                        <!-- Hero Synopsis Info Area (Top of Home) -->
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/heroInfoLayout"
                            android:layout_width="560dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/heroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:shadowColor="#99000000"
                                android:shadowDx="2"
                                android:shadowDy="2"
                                android:shadowRadius="6"
                                android:textColor="@color/white"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                tools:text="教父 第一部" />

                            <TextView
                                android:id="@+id/heroMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#CCFFFFFF"
                                android:textSize="13sp"
                                tools:text="4K 超清 · 9.4分 · 1972 · 剧情 / 犯罪" />

                            <TextView
                                android:id="@+id/heroDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:lineSpacingExtra="3dp"
                                android:maxLines="3"
                                android:textColor="#B3FFFFFF"
                                android:textSize="13sp"
                                tools:text="是一部1972年的美国黑帮电影，根据马里奥·普佐的1969年同名小说改编，弗朗西斯·科波拉执导，由马龙·白兰度和阿尔·帕西诺主演。" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <!-- Shelf 1: 现在观看 (Watch Now 16:9) -->
                        <TextView
                            android:id="@+id/headerWatchNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/shelf_watch_now"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <androidx.leanback.widget.HorizontalGridView
                            android:id="@+id/recyclerWatchNow"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nextFocusUp="@id/topNavRecycler"
                            android:nextFocusDown="@id/gridHot"
                            app:focusOutEnd="false"
                            app:focusOutFront="false" />

                        <!-- Shelf 2: 继续观看 (Continue Watching 16:9 with progress) -->
                        <TextView
                            android:id="@+id/headerContinue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/shelf_continue_watch"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <androidx.leanback.widget.HorizontalGridView
                            android:id="@+id/recyclerContinue"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:visibility="gone"
                            app:focusOutEnd="false"
                            app:focusOutFront="false"
                            tools:visibility="visible" />

                        <!-- Shelf 3: 正在热播 (Top Picks 5-Columns 2:3) -->
                        <TextView
                            android:id="@+id/headerHot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/shelf_hot_recommend"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/gridHot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nextFocusUp="@id/recyclerWatchNow"
                            android:nestedScrollingEnabled="false" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.core.widget.NestedScrollView>

                <!-- 2. Category View (Sub-category filters + 5-column poster grid) -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/categoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Sub-category Filter Bar -->
                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/categoryFilterRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:focusOutEnd="false"
                        app:focusOutFront="false" />

                    <!-- 5-Column Category Poster Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/categoryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nextFocusUp="@id/topNavRecycler"
                        android:paddingBottom="60dp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 3. Empty State Guide (When no subscription source is configured) -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/emptyView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:src="@drawable/ic_setting_home"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="欢迎使用 Apple TVBox"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="当前尚未配置视频源，请点击下方按钮或按遥控器 [菜单键] 配置源"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEmptyConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/selector_top_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:text="⚙️ 添加配置接口"
                        android:textColor="@color/selector_capsule_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </FrameLayout>
        </RelativeLayout>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- Layer 3: Floating Frosted Glass Side Drawer (Menu Triggered) -->
    <include
        android:id="@+id/sideDrawer"
        layout="@layout/layout_side_drawer" />

</FrameLayout>