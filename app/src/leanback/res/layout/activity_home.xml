<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Layer 0: Full-screen Hero Backdrop -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Layer 1: Dark Cinematic Scrim Overlay -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_scrim_hero" />

    <!-- Layer 2: Main Interactive Content Layer -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <!-- Top Navigation Bar (Logo + Capsule Tabs + TextClock) -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/logo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_logo" />

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/topNavRecycler"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:focusOutEnd="false"
                    app:focusOutFront="false" />

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/white_90"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="15:30" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Hero Synopsis Info Area (Visible on Home Tab) -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/heroInfoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="星际穿越 Interstellar" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    tools:text="4K 超清 · 2014 · 评分 9.4 · 科幻/冒险" />

                <TextView
                    android:id="@+id/heroDesc"
                    android:layout_width="650dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    tools:text="世界在历经极端气候与粮食危机，地球濒临末日。前NASA宇航员库珀受命带领一支探险队穿越虫洞，寻找适合人类迁徙的新家园..." />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Main Content Container -->
            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 1. Home Shelves View (Now Watching + Continue + Hot Picks) -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/homeScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingBottom="40dp">

                        <!-- Shelf 1: 现在观看 (Watch Now) -->
                        <TextView
                            android:id="@+id/headerWatchNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/shelf_watch_now"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <androidx.leanback.widget.HorizontalGridView
                            android:id="@+id/recyclerWatchNow"
                            android:layout_width="match_parent"
                            android:layout_height="165dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            app:focusOutEnd="false"
                            app:focusOutFront="false" />

                        <!-- Shelf 2: 继续观看 (Continue Watching) -->
                        <TextView
                            android:id="@+id/headerContinue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/shelf_continue_watch"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <androidx.leanback.widget.HorizontalGridView
                            android:id="@+id/recyclerContinue"
                            android:layout_width="match_parent"
                            android:layout_height="165dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:visibility="gone"
                            app:focusOutEnd="false"
                            app:focusOutFront="false"
                            tools:visibility="visible" />

                        <!-- Shelf 3: 正在热播 (Top Picks 5-Columns) -->
                        <TextView
                            android:id="@+id/headerHot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/shelf_hot_recommend"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/gridHot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.core.widget.NestedScrollView>

                <!-- 2. Category View (Sub-category filters + 5-column poster grid) -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/categoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Sub-category Filter Bar -->
                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/categoryFilterRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:focusOutEnd="false"
                        app:focusOutFront="false" />

                    <!-- 5-Column Category Poster Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/categoryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingBottom="40dp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </FrameLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- Layer 3: Floating Frosted Glass Side Drawer (Menu Triggered) -->
    <include
        android:id="@+id/sideDrawer"
        layout="@layout/layout_side_drawer" />

</FrameLayout>