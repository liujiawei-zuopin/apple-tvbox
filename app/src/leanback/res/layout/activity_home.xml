<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101012"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Underlying Visual Hierarchy wrapped in BlurTarget for Realtime Backdrop Sampling -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Layer 0a: Full-screen Hero Backdrop (Crisp High-Res) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Layer 0b: Full-screen Hero Blurred Backdrop (Apple tvOS Frosted Glass on Scroll) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/heroBlurBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <!-- Layer 0c: Deep Frosted Glass Tint Overlay (Permits vivid ambient blur) -->
    <View
        android:id="@+id/heroFrostedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#66101014" />

    <!-- Layer 0d: True StackBlur Frosted Ambient Backdrop for Category & Search Pages -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/categoryAmbientBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Layer 0e: Category Themed Ambient Frosted Tint (Emerald, Sapphire, Amethyst) -->
    <View
        android:id="@+id/categoryAmbientTint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ambient_default"
        android:visibility="gone" />

    <!-- Layer 0f: Deep Frosted Dim Filter for Category Pages -->
    <View
        android:id="@+id/categoryAmbientOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66101014"
        android:visibility="gone" />

    <!-- Layer 1: Dark Cinematic Scrim Overlay (First Screen Atmosphere) -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_scrim_hero" />

    <!-- Layer 2: Main Interactive Content Layer -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="44dp"
            android:paddingEnd="44dp">

            <!-- Main Interactive Content Container (Full Match-Parent, Top Bar Overlays It) -->
            <FrameLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 1. Home Shelves ScrollView (Hero Synopsis + Now Watching + Continue + Hot Picks) -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/homeScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/shelvesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingTop="48dp"
                        android:paddingBottom="80dp">

                        <!-- Hero Synopsis Info Area (Sunk to bottom-middle, maximizing backdrop exposure) -->
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/heroInfoLayout"
                            android:layout_width="660dp"
                            android:layout_height="115dp"
                            android:layout_marginTop="100dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/heroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                tools:text="教父 第一部" />

                            <TextView
                                android:id="@+id/heroMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#CCFFFFFF"
                                android:textSize="13sp"
                                tools:text="4K 超清 · 9.4分 · 1972 · 剧情 / 犯罪" />

                            <TextView
                                android:id="@+id/heroDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:textColor="#B3FFFFFF"
                                android:textSize="13sp"
                                tools:text="是一部1972年的美国黑帮电影，根据马里奥·普佐的1969年同名小说改编，弗朗西斯·科波拉执导，由马龙·白兰度和阿尔·帕西诺主演。" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <!-- Shelf 1: 现在观看 (Watch Now 16:9 Compact 138x78dp - Optical Alignment) -->
                        <TextView
                            android:id="@+id/headerWatchNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/shelf_watch_now"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerWatchNow"
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:layout_marginStart="-3.5dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />

                        <!-- Shelf 2: 继续观看 (Continue Watching 16:9 Compact 138x78dp with progress) -->
                        <TextView
                            android:id="@+id/headerContinue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/shelf_continue_watch"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerContinue"
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:layout_marginStart="-3.5dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <!-- Shelf 3: 正在热播 (Top Picks 5-Columns 2:3 Portrait cards) -->
                        <TextView
                            android:id="@+id/headerHot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="6dp"
                            android:text="@string/shelf_hot_recommend"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/gridHot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-6dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.core.widget.NestedScrollView>

                <!-- 2. Category Channel View (Apple TV+ rich channels with Hero, Play Button, Shelves & Grid) -->
                <include
                    android:id="@+id/categoryContainer"
                    layout="@layout/layout_category_channel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- 3. Embedded Search View (Apple TV style full Search Page) -->
                <include
                    android:id="@+id/searchContainer"
                    layout="@layout/layout_home_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- 4. Empty State Guide (When no subscription source is configured) -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/emptyView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:src="@drawable/ic_setting_home"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="欢迎使用 Apple TVBox"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="当前尚未配置视频源，请点击下方按钮或按遥控器 [菜单键] 配置源"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEmptyConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/selector_top_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="⚙️ 添加配置接口"
                        android:textColor="@color/selector_capsule_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </FrameLayout>

        </RelativeLayout>
    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Top Navigation Bar (Pure Floating Centered Frosted Capsule Bar with Realtime Blur) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:paddingStart="44dp"
        android:paddingEnd="44dp">

        <!-- Center: Apple TV Style Translucent Capsule Tabs Bar with True Realtime Blur -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/topNavBlurView"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerHorizontal="true"
            app:blurOverlayColor="#1EFFFFFF"
            android:background="@drawable/bg_top_capsule_bar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:paddingStart="3dp"
            android:paddingTop="3dp"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/topNavRecycler"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusDown="@id/recyclerWatchNow"
                android:orientation="horizontal" />
        </eightbitlab.com.blurview.BlurView>
    </RelativeLayout>

    <!-- Layer 3: Floating Frosted Glass Side Drawer (Menu Triggered) -->
    <include
        android:id="@+id/sideDrawer"
        layout="@layout/layout_side_drawer" />

</FrameLayout>