<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categoryScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/categoryContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="80dp">

        <!-- 1. Hero Carousel Banner Section -->
        <FrameLayout
            android:id="@+id/categoryHeroSection"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero Backdrop Image -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/categoryHeroBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Atmospheric Scrim (Left-to-Right + Top-to-Bottom gradient) -->
            <View
                android:id="@+id/categoryHeroScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_scrim_category_hero" />

            <!-- Bottom Smooth Transition Mask -->
            <View
                android:id="@+id/categoryHeroBottomMask"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_scrim_category_bottom" />

            <!-- Hero Synopsis & Play Button Info Layout -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/categoryHeroInfo"
                android:layout_width="660dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/categoryHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="周处除三害" />

                <TextView
                    android:id="@+id/categoryHeroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    tools:text="4K 超清 · 8.1分 · 2024 · 动作 / 犯罪" />

                <TextView
                    android:id="@+id/categoryHeroDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    tools:text="通缉犯陈桂林以为自己患上绝症，生命将尽，决心查出通缉榜上排名在自己前面的两大罪犯，并将其除掉以扬名立万。" />

                <!-- Apple tvOS Action Button: ▶ 立即播放 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/categoryBtnPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/selector_hero_play_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="20dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_widget_play"
                        app:tint="@color/selector_focus_white_pill_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:text="立即播放"
                        android:textColor="@color/selector_focus_white_pill_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>

        <!-- 2. Shelf 1: "推荐" (16:9 Landscape compact cards, same as Home's Watch Now) -->
        <TextView
            android:id="@+id/categoryHeaderRecommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:text="推荐"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerRecommend"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginStart="-3.5dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- 3. Shelf 2: Sub-genre 1 (e.g. 动作精选 - 2:3 Portrait Cards) -->
        <TextView
            android:id="@+id/categoryHeaderSubGenre1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="动作精选"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerSubGenre1"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            android:layout_marginStart="-3.5dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 4. Shelf 3: Sub-genre 2 (e.g. 爱情精选 - 2:3 Portrait Cards) -->
        <TextView
            android:id="@+id/categoryHeaderSubGenre2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="热门精选"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryRecyclerSubGenre2"
            android:layout_width="match_parent"
            android:layout_height="222dp"
            android:layout_marginStart="-3.5dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 5. Section 4: "全部影片" (All Movies / All Content with Filters & 5-Column Grid) -->
        <TextView
            android:id="@+id/categoryHeaderAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="全部影片"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sub-category Filter Chips -->
        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/categoryFilterRecycler"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:focusOutEnd="false"
            app:focusOutFront="false" />

        <!-- 5-Column Poster Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
