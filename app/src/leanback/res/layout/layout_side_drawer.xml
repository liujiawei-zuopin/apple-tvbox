<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Dim background overlay -->
    <View
        android:id="@+id/drawerMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="false" />

    <!-- Floating Frosted Glass Card -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/drawerPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_side_drawer"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Top Header Clock -->
        <TextClock
            android:id="@+id/drawerClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp"
            android:format12Hour="HH:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="15:30:00" />

        <!-- 9 Menu Entry Items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 搜索 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_action_search"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_search"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 2. 历史 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuHistory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_action_history"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_history"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 3. 直播 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuLive"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_nav_live"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_live"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 4. 配置 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuConfig"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_action_refresh"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_config"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 5. 线路 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuSite"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_action_site"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_site"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 6. 网盘 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuCloud"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_cloud"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 7. 收藏 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuCollect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_action_keep"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_collect"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 8. 推送 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuPush"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_sync_upload"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_push"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 9. 设置 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/menuSetting"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/selector_drawer_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_action_setting"
                        app:tint="@color/selector_drawer_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:duplicateParentState="true"
                        android:text="@string/menu_setting"
                        android:textColor="@color/selector_drawer_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
